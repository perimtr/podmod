+/* podmod: scripted input for headless theme screenshots (PODMOD_SCRIPT=file) */
+static void podmod_key(int sym, bool down)
+{
+    SDL_Event e;
+    memset(&e, 0, sizeof(e));
+    e.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+    e.key.keysym.sym = sym;
+    SDL_PushEvent(&e);
+}
+
+static int podmod_script_thread(void *arg)
+{
+    FILE *f = fopen((const char *)arg, "r");
+    char cmd[32], name[32];
+    int ms;
+    if (!f) return 0;
+    while (fscanf(f, "%31s", cmd) == 1) {
+        if (!strcmp(cmd, "wait") && fscanf(f, "%d", &ms) == 1) {
+            SDL_Delay(ms);
+        } else if ((!strcmp(cmd, "key") || !strcmp(cmd, "hold")) && fscanf(f, "%31s", name) == 1) {
+            int sym = 0;
+            ms = 60;
+            if (!strcmp(cmd, "hold")) fscanf(f, "%d", &ms);
+            if (!strcmp(name, "up")) sym = SDLK_UP;
+            else if (!strcmp(name, "down")) sym = SDLK_DOWN;
+            else if (!strcmp(name, "left")) sym = SDLK_LEFT;
+            else if (!strcmp(name, "right")) sym = SDLK_RIGHT;
+            else if (!strcmp(name, "select")) sym = SDLK_RETURN;
+            else if (!strcmp(name, "menu")) sym = SDLK_ESCAPE;
+            else if (!strcmp(name, "play")) sym = SDLK_SPACE;
+            if (sym) { podmod_key(sym, true); SDL_Delay(ms); podmod_key(sym, false); SDL_Delay(250); }
+        } else if (!strcmp(cmd, "dump")) {
+            podmod_key(SDLK_F5, true); SDL_Delay(60); podmod_key(SDLK_F5, false); SDL_Delay(500);
+        } else if (!strcmp(cmd, "raw") && fscanf(f, "%31s", name) == 1) {
+            extern SDL_Surface *lcd_surface; /* podmod_raw: works during boot too */
+            SDL_SaveBMP(lcd_surface, name);
+        } else if (!strcmp(cmd, "quit")) {
+            fflush(NULL);
+            _exit(0);
+        }
+    }
+    fclose(f);
+    return 0;
+}
