#! rockbox/tagbrowser/2.0
# podmod: a short, plain Music menu (replaces Rockbox's default database menu).
# Delete this file to get the stock menu back.

%format "fmt_title" "%d.%02d. %s" discnum tracknum title ? discnum > "0"
%format "fmt_title" "%02d. %s" tracknum title ? tracknum > "0"
%format "fmt_title" "%s" title

%menu_start "search" "Search"
"Artists" -> canonicalartist ? canonicalartist ~ "" -> album -> title = "fmt_title"
"Albums" -> album ? album ~ "" -> title = "fmt_title"
"Songs" -> title ? title ~ ""

%menu_start "main" "Music"
"Artists" -> canonicalartist -> album -> title = "fmt_title"
"Albums" -> album -> title = "fmt_title"
"Songs" -> title
"Genres" -> genre -> canonicalartist -> album -> title = "fmt_title"
"Recently Added" -> album ? entryage < "4" & commitid > "0" -> title = "fmt_title"
"Shuffle Songs" ~> title = "fmt_title"
"Search" ==> "search"

%root_menu "main"
